# Where the browser fetches parcels.parquet and parcels.pmtiles from.
# Local: run `npm run artifacts` in web/ and leave this as-is.
# Deployed: your R2 public bucket URL, set in the Vercel dashboard.
NEXT_PUBLIC_ARTIFACT_BASE=http://localhost:8787

# Shared login key. Use at least 24 random characters. Configure this as a
# sensitive Vercel environment variable; never prefix it with NEXT_PUBLIC_.
APP_ACCESS_KEY=

# Private Vercel Blob fallback for local development. Vercel deployments use
# the linked store's short-lived OIDC credentials automatically.
BLOB_READ_WRITE_TOKEN=
